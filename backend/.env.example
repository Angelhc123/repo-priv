# Postgres (Railway te da esta URL en la pestaña "Connect" de tu addon de Postgres)
DATABASE_URL=postgres://user:password@host:5432/railway

# Client ID de tipo "Aplicación web" (NO el de tipo Android) creado en Google
# Cloud Console > APIs & Services > Credentials. Es el mismo valor que se le
# pasa a GoogleSignIn(serverClientId: ...) del lado Flutter — así el idToken
# que genera el teléfono trae esta audience y el backend puede verificarla.
# El client ID de tipo Android también hay que crearlo (ligado al package +
# SHA-1 de la app), pero ese no se usa como variable acá.
GOOGLE_CLIENT_ID=TU_WEB_CLIENT_ID.apps.googleusercontent.com

# Secreto para firmar los JWT propios de esta API (no tiene que ver con Google).
# Generalo una vez con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_algo_largo_y_random

PORT=3000
