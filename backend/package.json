{
  "name": "coswim-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de CoSwim: autenticación con Google y almacenamiento de sesiones de nado en Postgres.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
