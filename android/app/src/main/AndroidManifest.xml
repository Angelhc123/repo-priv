<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Para hablar con coswim-backend (Google Sign-In + API). El debug
         build de Flutter la agrega sola, pero en release hay que declararla
         a mano o toda llamada http sale como "Permission denied". -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permissions for Health Connect -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE"/>
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <!-- Era READ_BLOOD_OXYGEN — ese permiso no existe en Health Connect, por
         eso "Oxígeno en sangre" nunca aparecía como opción activable en los
         ajustes de la app (confirmado contra androidx.health.connect:
         connect-client: el permiso real para OxygenSaturationRecord, que es
         el record que lee MainActivity.kt, es READ_OXYGEN_SATURATION). -->
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION"/>
    <!-- El código ya pedía SPEED como permiso "bonus" pero faltaba declararlo
         acá — sin esto Health Connect nunca lo iba a poder conceder. -->
    <uses-permission android:name="android.permission.health.READ_SPEED"/>
    <!-- Permisos extra solo para el volcado de diagnóstico (exportFullDump en
         MainActivity.kt) — pedimos todo lo que Health Connect pueda ofrecer
         relacionado a una sesión de entrenamiento, aunque el reloj no escriba
         la mayoría. Son "bonus", no bloquean el flujo normal si se deniegan. -->
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY"/>
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE"/>
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_VO2_MAX"/>
    <uses-permission android:name="android.permission.health.READ_SKIN_TEMPERATURE"/>
    <uses-permission android:name="android.permission.health.READ_POWER"/>
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED"/>
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED"/>

    <application
        android:label="coswim"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        
        <!-- Health Connect rationale activity alias -->
        <activity-alias
            android:name=".HealthConnectPermissionRationaleActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.health.READ_HEALTH_DATA">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Without this, HealthConnectClient can't see the Health Connect
             package on Android 11+ (package-visibility filtering) even when
             it IS installed — getOrCreate()/permission requests then fail
             silently as "unavailable", the system permission screen never
             launches, and coswim never registers with Health Connect at all
             (so it doesn't even show up under Health Connect → Aplicaciones).
             Neither androidx.health.connect:connect-client nor the `health`
             plugin declare this on the app's behalf — it's on us. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
